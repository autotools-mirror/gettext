#!/bin/sh
. "${srcdir=.}/init.sh"; path_prepend_ . ../src

# Test D support: NUL characters in extracted comments.

{
printf '// TRANSLATORS: This is an \0extracted comment.\n'
cat <<\EOF
string s1 = gettext("one");
EOF
printf '/* TRANSLATORS: This \0too. */\n'
cat <<\EOF
string s2 = gettext("two");
EOF
printf '/+ TRANSLATORS: This \0as well. +/\n'
cat <<\EOF
string s3 = gettext("three");
EOF
} > xg-d-nul-1.d

: ${XGETTEXT=xgettext}
${XGETTEXT} --omit-header --no-location --add-comments=TRANSLATORS: \
  -d xg-d-nul-1.tmp xg-d-nul-1.d || Exit 1
LC_ALL=C tr -d '\r' < xg-d-nul-1.tmp.po > xg-d-nul-1.po || Exit 1

{
printf '#. TRANSLATORS: This is an \0extracted comment.\n'
cat <<\EOF
msgid "one"
msgstr ""

EOF
printf '#. TRANSLATORS: This \0too.\n'
cat <<\EOF
msgid "two"
msgstr ""

EOF
printf '#. TRANSLATORS: This \0as well.\n'
cat <<\EOF
msgid "three"
msgstr ""
EOF
} > xg-d-nul-1.ok

cmp xg-d-nul-1.ok xg-d-nul-1.po
result=$?

exit $result
