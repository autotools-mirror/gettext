#!/bin/sh
. "${srcdir=.}/init.sh"; path_prepend_ . ../src

# Test Vala support: NUL characters in extracted comments.

func_find_good_tr

{
printf '// TRANSLATORS: This is an \0extracted comment.\n'
cat <<\EOF
var s1 = _("one");
EOF
printf '/* TRANSLATORS: This \0too. */\n'
cat <<\EOF
var s2 = _("two");
EOF
} > xg-vala-nul-1.vala

: ${XGETTEXT=xgettext}
${XGETTEXT} --omit-header --no-location --add-comments=TRANSLATORS: \
  -d xg-vala-nul-1.tmp xg-vala-nul-1.vala || Exit 1
LC_ALL=C $TR -d '\r' < xg-vala-nul-1.tmp.po > xg-vala-nul-1.po || Exit 1

{
printf '#. TRANSLATORS: This is an \0extracted comment.\n'
cat <<\EOF
msgid "one"
msgstr ""

EOF
printf '#. TRANSLATORS: This \0too.\n'
cat <<\EOF
msgid "two"
msgstr ""
EOF
} > xg-vala-nul-1.ok

cmp xg-vala-nul-1.ok xg-vala-nul-1.po
result=$?

exit $result
