#!/bin/sh
. "${srcdir=.}/init.sh"; path_prepend_ . ../src

# Test Perl support: NUL characters in extracted comments.

{
printf '# TRANSLATORS: This is an \0extracted comment.\n'
cat <<\EOF
print gettext "one";
EOF
} > xg-pl-nul-1.pl

: ${XGETTEXT=xgettext}
${XGETTEXT} --omit-header --no-location --add-comments=TRANSLATORS: \
  -d xg-pl-nul-1.tmp xg-pl-nul-1.pl || Exit 1
LC_ALL=C tr -d '\r' < xg-pl-nul-1.tmp.po > xg-pl-nul-1.po || Exit 1

{
printf '#. TRANSLATORS: This is an \0extracted comment.\n'
cat <<\EOF
msgid "one"
msgstr ""
EOF
} > xg-pl-nul-1.ok

cmp xg-pl-nul-1.ok xg-pl-nul-1.po
result=$?

exit $result
