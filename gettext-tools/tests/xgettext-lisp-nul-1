#!/bin/sh
. "${srcdir=.}/init.sh"; path_prepend_ . ../src

# Test Lisp support: NUL characters in extracted comments.

func_find_good_tr

{
printf '; TRANSLATORS: This is an \0extracted comment.\n'
cat <<\EOF
(write-line (gettext "one"))
EOF
printf '#| TRANSLATORS: This \0too. |#\n'
cat <<\EOF
(write-line (gettext "two"))
EOF
EOF
} > xg-ls-nul-1.lisp

: ${XGETTEXT=xgettext}
${XGETTEXT} --omit-header --no-location --add-comments=TRANSLATORS: \
  -d xg-ls-nul-1.tmp xg-ls-nul-1.lisp || Exit 1
LC_ALL=C $TR -d '\r' < xg-ls-nul-1.tmp.po > xg-ls-nul-1.po || Exit 1

{
printf '#. TRANSLATORS: This is an \0extracted comment.\n'
cat <<\EOF
msgid "one"
msgstr ""

EOF
printf '#. TRANSLATORS: This \0too.\n'
cat <<\EOF
msgid "two"
msgstr ""
EOF
} > xg-ls-nul-1.ok

cmp xg-ls-nul-1.ok xg-ls-nul-1.po
result=$?

exit $result
