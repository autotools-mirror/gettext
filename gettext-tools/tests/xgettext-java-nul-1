#!/bin/sh
. "${srcdir=.}/init.sh"; path_prepend_ . ../src

# Test Java support: NUL characters in extracted comments.

{
printf '// TRANSLATORS: This is an \0extracted comment.\n'
cat <<\EOF
System.out.println(gettext("one"));
EOF
printf '/* TRANSLATORS: This \0too. */\n'
cat <<\EOF
System.out.println(gettext("two"));
EOF
} > xg-j-nul-1.java

: ${XGETTEXT=xgettext}
${XGETTEXT} --omit-header --no-location --add-comments=TRANSLATORS: \
  -d xg-j-nul-1.tmp xg-j-nul-1.java || Exit 1
LC_ALL=C tr -d '\r' < xg-j-nul-1.tmp.po > xg-j-nul-1.po || Exit 1

{
printf '#. TRANSLATORS: This is an \0extracted comment.\n'
cat <<\EOF
msgid "one"
msgstr ""

EOF
printf '#. TRANSLATORS: This \0too.\n'
cat <<\EOF
msgid "two"
msgstr ""
EOF
} > xg-j-nul-1.ok

cmp xg-j-nul-1.ok xg-j-nul-1.po
result=$?

exit $result
