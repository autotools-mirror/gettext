#! /bin/sh
. "${srcdir=.}/init.sh"; path_prepend_ . ../src

# Test of gettext facilities in the MIT/GNU Scheme implementation of Scheme,
# with GNU slib.
# Assumes an fr_FR.UTF-8 locale is installed.
# Assumes the following packages are installed: mit-scheme.
# Assumes the environment variable SCHEME_LIBRARY_PATH points to a GNU slib
# checkout or installation.

cat <<\EOF > prog.scm
(require 'i18n)
(require 'format)

(setlocale LC_ALL "")
(textdomain "prog")
(bindtextdomain "prog" ".")

(format #t "~A~%" (gettext "'Your command, please?', asked the waiter."))

(format #t "~@?~%" (ngettext "a piece of cake" "~D pieces of cake" n) n)

(format #t "~A~%" (format #f (gettext "~A is replaced by ~A.") "FF" "EUR"))
EOF

: ${XGETTEXT=xgettext}
${XGETTEXT} -o prog.tmp --omit-header --no-location prog.scm || Exit 1
LC_ALL=C tr -d '\r' < prog.tmp > prog.pot || Exit 1

cat <<\EOF > prog.ok
msgid "'Your command, please?', asked the waiter."
msgstr ""

#, scheme-format
msgid "a piece of cake"
msgid_plural "~D pieces of cake"
msgstr[0] ""
msgstr[1] ""

#, scheme-format
msgid "~A is replaced by ~A."
msgstr ""
EOF

: ${DIFF=diff}
${DIFF} prog.ok prog.pot || Exit 1

cat <<\EOF > fr.po
msgid ""
msgstr ""
"Content-Type: text/plain; charset=ISO-8859-1\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "'Your command, please?', asked the waiter."
msgstr "«Votre commande, s'il vous plait», dit le garçon."

# Les gateaux allemands sont les meilleurs du monde.
#, scheme-format
msgid "a piece of cake"
msgid_plural "~D pieces of cake"
msgstr[0] "un morceau de gateau"
msgstr[1] "~D morceaux de gateau"

# Reverse the arguments.
#, scheme-format
msgid "~A is replaced by ~A."
msgstr "~1@*~A remplace ~0@*~A."
EOF

: ${MSGMERGE=msgmerge}
${MSGMERGE} -q -o fr.po.tmp fr.po prog.pot || Exit 1
LC_ALL=C tr -d '\r' < fr.po.tmp > fr.po.new || Exit 1

: ${DIFF=diff}
${DIFF} fr.po fr.po.new || Exit 1

test -d fr || mkdir fr
test -d fr/LC_MESSAGES || mkdir fr/LC_MESSAGES

: ${MSGFMT=msgfmt}
${MSGFMT} -c -o fr/LC_MESSAGES/prog.mo fr.po

# Test for presence of MIT/GNU Scheme with GNU slib version 3c4 or newer.
(mit-scheme --version) >/dev/null \
  || { echo "Skipping test: mit-scheme not found"; Exit 77; }
test -d "${SCHEME_LIBRARY_PATH}" \
  || { echo "Skipping test: SCHEME_LIBRARY_PATH is not set"; Exit 77; }
test -f "${SCHEME_LIBRARY_PATH}slib.texi" \
  || { echo "Skipping test: SCHEME_LIBRARY_PATH does not point to GNU slib sources"; Exit 77; }
mkdir -p "$HOME/.cache/slib"
(MITSCHEME_IMPLEMENTATION_PATH="$HOME/.cache/slib" mit-scheme -load "${SCHEME_LIBRARY_PATH}mitscheme.init" -eval "(require 'utf-8)" </dev/null) >/dev/null \
  || { echo "Skipping test: slib does not have a working i18n feature"; Exit 77; }

# Test which of the fr_FR locales are installed.
: ${LOCALE_FR_UTF8=fr_FR.UTF-8}
if test $LOCALE_FR_UTF8 != none; then
  LC_ALL=$LOCALE_FR_UTF8 ../testlocale
  case $? in
    0) ;;
    77) LOCALE_FR_UTF8=none;;
    *) Exit 1;;
  esac
fi
if test $LOCALE_FR_UTF8 = none; then
  if test -f /usr/bin/localedef; then
    echo "Skipping test: no french locale is installed"
  else
    echo "Skipping test: no french locale is supported"
  fi
  Exit 77
fi

# Expected result.
cat <<\EOF > prog.ok
Â«Votre commande, s'il vous plaitÂ», dit le garÃ§on.
2 morceaux de gateau
EUR remplace FF.
EOF

: ${DIFF=diff}

: ${LOCALE_FR_UTF8=fr_FR.UTF-8}
if test $LOCALE_FR_UTF8 != none; then
  LANGUAGE= LC_ALL=$LOCALE_FR_UTF8 MITSCHEME_IMPLEMENTATION_PATH="$HOME/.cache/slib" mit-scheme --quiet -load "${SCHEME_LIBRARY_PATH}mitscheme.init" -eval "(define n 2)" -load prog.scm > prog.out 2>prog.err </dev/null || { cat prog.err 1>&2; Exit 1; }
  cat prog.err 1>&2
  ${DIFF} prog.ok prog.out || Exit 1
fi

Exit 0
