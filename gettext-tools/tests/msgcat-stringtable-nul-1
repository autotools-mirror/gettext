#! /bin/sh
. "${srcdir=.}/init.sh"; path_prepend_ . ../src

# Verify that msgcat supports NUL characters in translator comments and
# extracted comments, with --stringtable-input.

{
printf '// This is a translator \0comment\n'
printf '// with several \0\0NUL\0\0 characters.\n'
printf '// Comment: This is an \0extracted comment.\n'
cat <<\EOF
"Simple" = "Einfach";
EOF
} > mcat-s-nul-1.in

: ${MSGCAT=msgcat}
${MSGCAT} --stringtable-input -o mcat-s-nul-1.tmp mcat-s-nul-1.in || Exit 1
LC_ALL=C tr -d '\r' < mcat-s-nul-1.tmp > mcat-s-nul-1.out || Exit 1

{
printf '# This is a translator \0comment\n'
printf '# with several \0\0NUL\0\0 characters.\n'
printf '#. This is an \0extracted comment.\n'
cat <<\EOF
msgid "Simple"
msgstr "Einfach"
EOF
} > mcat-s-nul-1.ok

cmp mcat-s-nul-1.ok mcat-s-nul-1.out
result=$?

exit $result
