#!/bin/sh
. "${srcdir=.}/init.sh"; path_prepend_ . ../src

# Test Perl support: NUL characters in msgids.

{
printf 'print gettext "one\0dot";\n'
cat <<\EOF
print gettext "two dots";
EOF
} > xg-pl-nul-2.pl

: ${XGETTEXT=xgettext}
${XGETTEXT} --omit-header --no-location --add-comments=TRANSLATORS: \
  -d xg-pl-nul-2.tmp xg-pl-nul-2.pl 2>xg-pl-nul-2.err || Exit 1
test -s xg-pl-nul-2.err || Exit 1
cat xg-pl-nul-2.err
LC_ALL=C tr -d '\r' < xg-pl-nul-2.tmp.po > xg-pl-nul-2.po || Exit 1

cat <<\EOF > xg-pl-nul-2.ok
msgid "two dots"
msgstr ""
EOF

: ${DIFF=diff}
${DIFF} xg-pl-nul-2.ok xg-pl-nul-2.po
result=$?

exit $result
