#!/bin/sh
. "${srcdir=.}/init.sh"; path_prepend_ . ../src

# Test Modula-2 support: NUL characters in msgids.

{
printf 's1 = Gettext("one\0dot");\n'
cat <<\EOF
s2 = Gettext("two dots");
EOF
} > xg-m2-nul-2.mod

: ${XGETTEXT=xgettext}
${XGETTEXT} --omit-header --no-location --add-comments=TRANSLATORS: \
  -d xg-m2-nul-2.tmp xg-m2-nul-2.mod 2>xg-m2-nul-2.err || Exit 1
test -s xg-m2-nul-2.err || Exit 1
cat xg-m2-nul-2.err
LC_ALL=C tr -d '\r' < xg-m2-nul-2.tmp.po > xg-m2-nul-2.po || Exit 1

cat <<\EOF > xg-m2-nul-2.ok
msgid "two dots"
msgstr ""
EOF

: ${DIFF=diff}
${DIFF} xg-m2-nul-2.ok xg-m2-nul-2.po
result=$?

exit $result
