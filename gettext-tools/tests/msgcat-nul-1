#! /bin/sh
. "${srcdir=.}/init.sh"; path_prepend_ . ../src

# Verify that msgcat supports NUL characters in translator comments and
# extracted comments.

{
printf '# This is a translator \0comment\n'
printf '# with several \0\0NUL\0\0 characters.\n'
printf '#. This is an \0extracted comment.\n'
cat <<\EOF
msgid "Simple"
msgstr "Einfach"
EOF
} > mcat-nul-1.in

: ${MSGCAT=msgcat}
${MSGCAT} -o mcat-nul-1.tmp mcat-nul-1.in || Exit 1
LC_ALL=C tr -d '\r' < mcat-nul-1.tmp > mcat-nul-1.out || Exit 1

cmp mcat-nul-1.in mcat-nul-1.out
result=$?

exit $result
