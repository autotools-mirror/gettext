#!/bin/sh
. "${srcdir=.}/init.sh"; path_prepend_ . ../src

# Test EmacsLisp support: NUL characters in msgids.

{
printf '(princ (_ "one\0dot"))\n'
cat <<\EOF
(princ (_ "two dots"))
EOF
} > xg-el-nul-2.el

: ${XGETTEXT=xgettext}
${XGETTEXT} --omit-header --no-location --add-comments=TRANSLATORS: \
  -d xg-el-nul-2.tmp xg-el-nul-2.el 2>xg-el-nul-2.err || Exit 1
test -s xg-el-nul-2.err || Exit 1
cat xg-el-nul-2.err
LC_ALL=C tr -d '\r' < xg-el-nul-2.tmp.po > xg-el-nul-2.po || Exit 1

cat <<\EOF > xg-el-nul-2.ok
msgid "two dots"
msgstr ""
EOF

: ${DIFF=diff}
${DIFF} xg-el-nul-2.ok xg-el-nul-2.po
result=$?

exit $result
