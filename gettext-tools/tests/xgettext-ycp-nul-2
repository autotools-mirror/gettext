#!/bin/sh
. "${srcdir=.}/init.sh"; path_prepend_ . ../src

# Test YCP support: NUL characters in msgids.

{
printf 'print (_("one\0dot"));\n'
cat <<\EOF
print (_("two dots"));
EOF
} > xg-y-nul-2.ycp

: ${XGETTEXT=xgettext}
${XGETTEXT} --omit-header --no-location --add-comments=TRANSLATORS: \
  -d xg-y-nul-2.tmp xg-y-nul-2.ycp 2>xg-y-nul-2.err || Exit 1
test -s xg-y-nul-2.err || Exit 1
cat xg-y-nul-2.err
LC_ALL=C tr -d '\r' < xg-y-nul-2.tmp.po > xg-y-nul-2.po || Exit 1

cat <<\EOF > xg-y-nul-2.ok
msgid "two dots"
msgstr ""
EOF

: ${DIFF=diff}
${DIFF} xg-y-nul-2.ok xg-y-nul-2.po
result=$?

exit $result
