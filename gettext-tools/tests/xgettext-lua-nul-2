#!/bin/sh
. "${srcdir=.}/init.sh"; path_prepend_ . ../src

# Test Lua support: NUL characters in msgids.

{
printf 'print(_"one\0dot")\n'
cat <<\EOF
print(_"two dots")
EOF
} > xg-lu-nul-2.lua

: ${XGETTEXT=xgettext}
${XGETTEXT} --omit-header --no-location --add-comments=TRANSLATORS: \
  -d xg-lu-nul-2.tmp xg-lu-nul-2.lua 2>xg-lu-nul-2.err || Exit 1
test -s xg-lu-nul-2.err || Exit 1
cat xg-lu-nul-2.err
LC_ALL=C tr -d '\r' < xg-lu-nul-2.tmp.po > xg-lu-nul-2.po || Exit 1

cat <<\EOF > xg-lu-nul-2.ok
msgid "two dots"
msgstr ""
EOF

: ${DIFF=diff}
${DIFF} xg-lu-nul-2.ok xg-lu-nul-2.po
result=$?

exit $result
