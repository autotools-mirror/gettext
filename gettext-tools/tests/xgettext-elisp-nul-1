#!/bin/sh
. "${srcdir=.}/init.sh"; path_prepend_ . ../src

# Test EmacsLisp support: NUL characters in extracted comments.

{
printf '; TRANSLATORS: This is an \0extracted comment.\n'
cat <<\EOF
(princ (_ "one"))
EOF
} > xg-el-nul-1.el

: ${XGETTEXT=xgettext}
${XGETTEXT} --omit-header --no-location --add-comments=TRANSLATORS: \
  -d xg-el-nul-1.tmp xg-el-nul-1.el || Exit 1
LC_ALL=C tr -d '\r' < xg-el-nul-1.tmp.po > xg-el-nul-1.po || Exit 1

{
printf '#. TRANSLATORS: This is an \0extracted comment.\n'
cat <<\EOF
msgid "one"
msgstr ""
EOF
} > xg-el-nul-1.ok

cmp xg-el-nul-1.ok xg-el-nul-1.po
result=$?

exit $result
