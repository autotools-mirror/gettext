#!/bin/sh
. "${srcdir=.}/init.sh"; path_prepend_ . ../src

# Test Smalltalk support: NUL characters in extracted comments.

func_find_good_tr

{
printf '"TRANSLATORS: This is an \0extracted comment."\n'
cat <<\EOF
Transcript showCr: (NLS ? 'one').
EOF
} > xg-st-nul-1.st

: ${XGETTEXT=xgettext}
${XGETTEXT} --omit-header --no-location --add-comments=TRANSLATORS: \
  -d xg-st-nul-1.tmp xg-st-nul-1.st || Exit 1
LC_ALL=C $TR -d '\r' < xg-st-nul-1.tmp.po > xg-st-nul-1.po || Exit 1

{
printf '#. TRANSLATORS: This is an \0extracted comment.\n'
cat <<\EOF
msgid "one"
msgstr ""
EOF
} > xg-st-nul-1.ok

cmp xg-st-nul-1.ok xg-st-nul-1.po
result=$?

exit $result
