#!/bin/sh
. "${srcdir=.}/init.sh"; path_prepend_ . ../src

# Test Python support: NUL characters in extracted comments.

{
printf '# TRANSLATORS: This is an \0extracted comment.\n'
cat <<\EOF
_("one")
EOF
} > xg-py-nul-1.py

: ${XGETTEXT=xgettext}
${XGETTEXT} --omit-header --no-location --add-comments=TRANSLATORS: \
  -d xg-py-nul-1.tmp xg-py-nul-1.py || Exit 1
LC_ALL=C tr -d '\r' < xg-py-nul-1.tmp.po > xg-py-nul-1.po || Exit 1

{
printf '#. TRANSLATORS: This is an \0extracted comment.\n'
cat <<\EOF
msgid "one"
msgstr ""
EOF
} > xg-py-nul-1.ok

cmp xg-py-nul-1.ok xg-py-nul-1.po
result=$?

exit $result
