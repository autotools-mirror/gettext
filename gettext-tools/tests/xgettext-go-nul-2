#!/bin/sh
. "${srcdir=.}/init.sh"; path_prepend_ . ../src

# Test Go support: NUL characters in msgids.

{
cat <<\EOF
package main
import (
  "fmt"
  "github.com/leonelquinteros/gotext"
)
func main () {
EOF
printf 'fmt.Println(gotext.Get("one\0dot"))\n'
cat <<\EOF
fmt.Println(gotext.Get("two dots"))
}
EOF
} > xg-go-nul-2.go

: ${XGETTEXT=xgettext}
${XGETTEXT} --omit-header --no-location --add-comments=TRANSLATORS: \
  -d xg-go-nul-2.tmp xg-go-nul-2.go 2>xg-go-nul-2.err || Exit 1
test -s xg-go-nul-2.err || Exit 1
cat xg-go-nul-2.err
LC_ALL=C tr -d '\r' < xg-go-nul-2.tmp.po > xg-go-nul-2.po || Exit 1

cat <<\EOF > xg-go-nul-2.ok
msgid "two dots"
msgstr ""
EOF

: ${DIFF=diff}
${DIFF} xg-go-nul-2.ok xg-go-nul-2.po
result=$?

exit $result
