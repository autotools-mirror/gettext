#!/bin/sh
. "${srcdir=.}/init.sh"; path_prepend_ . ../src

# Test Python support: NUL characters in msgids.

{
printf '_("one\0dot")\n'
cat <<\EOF
_("two dots")
EOF
} > xg-py-nul-2.py

: ${XGETTEXT=xgettext}
${XGETTEXT} --omit-header --no-location --add-comments=TRANSLATORS: \
  -d xg-py-nul-2.tmp xg-py-nul-2.py 2>xg-py-nul-2.err || Exit 1
test -s xg-py-nul-2.err || Exit 1
cat xg-py-nul-2.err
LC_ALL=C tr -d '\r' < xg-py-nul-2.tmp.po > xg-py-nul-2.po || Exit 1

cat <<\EOF > xg-py-nul-2.ok
msgid "two dots"
msgstr ""
EOF

: ${DIFF=diff}
${DIFF} xg-py-nul-2.ok xg-py-nul-2.po
result=$?

exit $result
