#!/bin/sh
. "${srcdir=.}/init.sh"; path_prepend_ . ../src

# Test PHP support: NUL characters in msgids.

{
cat <<\EOF
<?
EOF
printf 'echo _("one\0dot");\n'
cat <<\EOF
echo _("two dots");
?>
EOF
} > xg-ph-nul-2.php

: ${XGETTEXT=xgettext}
${XGETTEXT} --omit-header --no-location --add-comments=TRANSLATORS: \
  -d xg-ph-nul-2.tmp xg-ph-nul-2.php 2>xg-ph-nul-2.err || Exit 1
test -s xg-ph-nul-2.err || Exit 1
cat xg-ph-nul-2.err
LC_ALL=C tr -d '\r' < xg-ph-nul-2.tmp.po > xg-ph-nul-2.po || Exit 1

cat <<\EOF > xg-ph-nul-2.ok
msgid "two dots"
msgstr ""
EOF

: ${DIFF=diff}
${DIFF} xg-ph-nul-2.ok xg-ph-nul-2.po
result=$?

exit $result
