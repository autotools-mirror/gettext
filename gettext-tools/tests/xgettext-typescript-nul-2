#!/bin/sh
. "${srcdir=.}/init.sh"; path_prepend_ . ../src

# Test TypeScript support: NUL characters in msgids.

{
printf 'let s1: string = _("one\0dot");\n'
cat <<\EOF
let s2: string = _("two dots");
EOF
} > xg-ts-nul-2.ts

: ${XGETTEXT=xgettext}
${XGETTEXT} --omit-header --no-location --add-comments=TRANSLATORS: \
  -d xg-ts-nul-2.tmp xg-ts-nul-2.ts 2>xg-ts-nul-2.err || Exit 1
test -s xg-ts-nul-2.err || Exit 1
cat xg-ts-nul-2.err
LC_ALL=C tr -d '\r' < xg-ts-nul-2.tmp.po > xg-ts-nul-2.po || Exit 1

cat <<\EOF > xg-ts-nul-2.ok
msgid "two dots"
msgstr ""
EOF

: ${DIFF=diff}
${DIFF} xg-ts-nul-2.ok xg-ts-nul-2.po
result=$?

exit $result
