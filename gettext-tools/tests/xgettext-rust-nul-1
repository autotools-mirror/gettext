#!/bin/sh
. "${srcdir=.}/init.sh"; path_prepend_ . ../src

# Test Rust support: NUL characters in extracted comments.

func_find_good_tr

{
cat <<\EOF
pub trait TestCase {
  fn main () {
EOF
printf '    // TRANSLATORS: This is an \0extracted comment.\n'
cat <<\EOF
    String s1 = gettext("one");
EOF
printf '    /* TRANSLATORS: This \0too. */\n'
cat <<\EOF
    String s2 = gettext("two");
  }
}
EOF
} > xg-rs-nul-1.rs

: ${XGETTEXT=xgettext}
${XGETTEXT} --omit-header --no-location --add-comments=TRANSLATORS: \
  -d xg-rs-nul-1.tmp xg-rs-nul-1.rs || Exit 1
LC_ALL=C $TR -d '\r' < xg-rs-nul-1.tmp.po > xg-rs-nul-1.po || Exit 1

{
printf '#. TRANSLATORS: This is an \0extracted comment.\n'
cat <<\EOF
msgid "one"
msgstr ""

EOF
printf '#. TRANSLATORS: This \0too.\n'
cat <<\EOF
msgid "two"
msgstr ""
EOF
} > xg-rs-nul-1.ok

cmp xg-rs-nul-1.ok xg-rs-nul-1.po
result=$?

exit $result
